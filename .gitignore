# Model checkpoints and weights (prevents exceeding GitHub's 100MB file limit)
checkpoints/
models/pretrained/
models/*.pkl
*.pkl
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
wandb/

# Encoder grid: regenerated artifacts, not results.
# _embeddings is written by precompute_embeddings.py and _lookup by data.build_vector_lookup;
# both are derived from files already in the repository and must be rebuilt on whichever machine
# runs the sweep. Committing a CPU-built table and then reading it on the DGX is exactly the kind
# of silent mismatch this grid is meant to avoid.
experiments/results/encoder_grid/_embeddings/
experiments/results/encoder_grid/_lookup/
experiments/results/encoder_comparison/_lookup/
